NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Use DATABASE_URL or the DB_* fields. Never include real credentials in a ZIP.
# DATABASE_URL=postgresql://user:password@localhost:5432/sqlishield
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sqlishield
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=0
# Optional. Password recovery is unavailable until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Protected sample app settings:
WAF_MODE=local
SQLISHIELD_BACKEND_URL=http://localhost:3000
SQLISHIELD_API_KEY=
